  "replayScenarios": [
    {
      "id": "payment_provider_sandbox_success",
      "owner": "Commerce Lead",
      "providerEnvironment": "sandbox",
      "callbackType": "payment",
      "expectedResult": "paid_entitlement_granted",
      "requiredEvidence": ["provider_payload", "signature", "order_state", "device_entitlement"]
    },
    {
      "id": "payment_provider_duplicate_event",
      "owner": "Backend Lead",
      "providerEnvironment": "sandbox",
      "callbackType": "payment",
      "expectedResult": "idempotent_same_event",
      "requiredEvidence": ["providerEventId", "callback_event", "operation_log_count"]
    },
    {
      "id": "payment_provider_invalid_signature",
      "owner": "Security",
      "providerEnvironment": "sandbox",
      "callbackType": "payment",
      "expectedResult": "invalid_payment_signature",
      "requiredEvidence": ["bad_signature_payload", "http_400_response"]
    },
    {
      "id": "payment_provider_amount_mismatch",
      "owner": "Commerce Lead",
      "providerEnvironment": "sandbox",
      "callbackType": "payment",
      "expectedResult": "blocked_no_entitlement",
      "requiredEvidence": ["provider_payload", "amount_currency_diff", "order_state"]
    },
    {
      "id": "payment_provider_failed_payment",
      "owner": "Commerce Lead",
      "providerEnvironment": "sandbox",
      "callbackType": "payment",
      "expectedResult": "failed_no_entitlement",
      "requiredEvidence": ["provider_payload", "order_state"]
    },
    {
      "id": "payment_provider_refund_success",
      "owner": "Commerce Lead",
      "providerEnvironment": "sandbox",
      "callbackType": "refund",
      "expectedResult": "refunded_entitlement_revoked",
      "requiredEvidence": ["provider_payload", "refund_event", "entitlement_state"]
    },
    {
      "id": "payment_provider_refund_duplicate",
      "owner": "Backend Lead",
      "providerEnvironment": "sandbox",
      "callbackType": "refund",
      "expectedResult": "idempotent_same_refund_event",
      "requiredEvidence": ["providerEventId", "refund_callback_event", "operation_log_count"]
    }
