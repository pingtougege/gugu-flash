# Gugu Flash backend local environment.
# Copy to apps/backend/.env and fill real values locally.
# Do not commit real API keys.

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# Optional OpenAI fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# deepseek or openai. Leave empty to prefer DeepSeek when configured.
STORY_IMPORT_LLM_PROVIDER=deepseek

# Optional image generation through Volcano Ark / Seedream.
SEEDREAM_API_KEY=
SEEDREAM_API_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations
SEEDREAM_MODEL=doubao-seedream-5-0-260128
SEEDREAM_QUALITY=2K
SEEDREAM_ASPECT_RATIO=1:1
SEEDREAM_WIDTH=1024
SEEDREAM_HEIGHT=1024
SEEDREAM_OUTPUT_FORMAT=jpeg
SEEDREAM_WATERMARK=false
SEEDREAM_MAX_IMAGES=1
